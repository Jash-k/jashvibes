# JaSH Theatre - minimal environment
# Required
DB=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/jash_theatre?retryWrites=true&w=majority
TMDB=your_tmdb_v3_api_key
PASS=choose_your_private_theatre_password

# Optional
# PROVIDERS=tamilott,screenscape,vidlink,vidnest,videasy,vidzee,vidrock,vixsrc,oneembed,vidsrcsbs,vidsrc
# TAMILMV=https://www.1tamilmv.report/
# OTT=https://tamilott.vercel.app/tamil_movies.json,https://tamilott.vercel.app/tamil_dubbed.json
# Optional Jio fallback token override (normally refreshed automatically)
# JIO_LIVE_COOKIE=__hdnea__=st=...~exp=...~acl=/*~hmac=...

# Stremio source(s) — Telegram-stremio addon manifest URLs.
# STREMIO is the catalog addon, STREMIO_WATCH an optional provider addon.
# The built-in /api/stream-proxy relay emulates HTTP Range for chunk-stream
# (telegram-style) sources so video seeking works; it only proxies hosts
# owned by these addons (plus STREAM_PROXY_HOSTS extras), never open targets.
# STREMIO=https://your-telegram-addon.example.com/manifest.json
# STREMIO_WATCH=https://your-provider-addon.example.com/manifest.json
# STREAM_PROXY_HOSTS=extra-file-host.example.com

# Clean Embed Browser
# EMBED=https://piratexplay.cc/language/tamil/
# ELABEL=PirateXPlay Tamil
# EMBEDS=PirateXPlay Tamil|https://piratexplay.cc/language/tamil/,Example|https://example.com

# Tamil Classics VOD M3U sources
# VOD=ErosNow|https://raw.githubusercontent.com/USER/REPO/main/VOD_ErosNow.m3u,Aha|https://raw.githubusercontent.com/USER/REPO/main/VOD_Aha.m3u
