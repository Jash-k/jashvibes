# JaSH Theatre - minimal environment
# Required
DB=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/jash_theatre?retryWrites=true&w=majority
TMDB=your_tmdb_v3_api_key
PASS=choose_your_private_theatre_password

# Optional
# PROVIDERS=stremio,mirchi,vidlink,videasy,vidzee,vidrock
# TAMILMV=https://www.1tamilmv.report/
# Internal keep-alive — pings /api/health every KEEPALIVE_MINUTES (default 10)
# so Render/Koyeb free tier never sleeps. Tiny traffic; keep it on.
# KEEPALIVE=0 disables it.
# KEEPALIVE_MINUTES=10

# Global Mirchi (nxsha.space) embed host override — default is fine
# MIRCHI_BASE_URL=https://nxsha.space

# Optional Jio fallback token override (normally refreshed automatically)
# JIO_LIVE_COOKIE=__hdnea__=st=...~exp=...~acl=/*~hmac=...

# Stremio source(s) — Telegram-stremio addon manifest URLs.
# STREMIO is the catalog addon, STREMIO_WATCH an optional provider addon.
# Optional: the Global Stremio addon is used by default when nothing is set.
# STREMIO=https://mobile-marika-magizchisoftware-b0475823.koyeb.app/stremio/thalaajith/manifest.json

# Clean Embed Browser
# EMBED=https://piratexplay.cc/language/tamil/
# ELABEL=PirateXPlay Tamil
# EMBEDS=PirateXPlay Tamil|https://piratexplay.cc/language/tamil/,Example|https://example.com

# Tamil Classics VOD M3U sources
# VOD=ErosNow|https://raw.githubusercontent.com/USER/REPO/main/VOD_ErosNow.m3u,Aha|https://raw.githubusercontent.com/USER/REPO/main/VOD_Aha.m3u

# Sports board (/sports) — one feed, one hub, four tabs (Live Score · Video · Info · Scorecard).
# All optional: with nothing set the board reads the BCCI + ICC schedules on the backend below and the
# published FanCode dump, merges them, and never invents a stream. A live match re-reads every 20s,
# an idle board every 5 minutes, and nothing polls in the background.
# MOVIES1_BACKEND=https://movies1-backend.onrender.com      # BCCI/ICC schedule, innings, ICC highlight resolver
# SPORTS_BACKEND=https://movies1-backend.onrender.com       # used only when MOVIES1_BACKEND is unset
# FANCODE_DUMP_URL=https://example.org/fancode.json         # the dump whose auto_streams the Video tab can play

# Two static channels the hub aside can offer when no match stream resolves. Add _NAME, _LOGO, _COOKIE,
# _UA, _REFERER, and for DRM _KEY_ID/_KEY or _LICENSE_KEY; an entry with a keyId but no key is listed as
# "needs a key" and never offered as playable.
# SPORTS_FANCODE_URL=https://example.org/fancode.m3u8
# SPORTS_WILLOW_URL=https://example.org/willow.mpd

# Live TV service panel password (unlock code for /live → Service panel).
# Also works at the main site unlock. Default: tv2010
LIVE_TV_PASS=tv2010

# Live TV guide (EPG) — /live reads now/next + today's blocks from an XMLTV feed.
# Everything here is optional: the default feed is Pocket-EPG (JioTV ids + name matching), fetched
# once per hour, parsed once per day into an in-process index, and never written to MongoDB.
# Measured on a 512 MB instance: ~0.8 s and ~15 MB for a 3.3 MB gzip / 65 MB XMLTV day index.
# LIVE_EPG_URL=https://example.org/epg.xml.gz
# LIVE_EPG_TTL_MS=3600000                             # how long a parsed day is reused (min 60s)
# LIVE_EPG_TIMEOUT_MS=25000                            # feed download timeout
# LIVE_EPG_TZ_MINUTES=330                              # assumed zone for stamps without an offset
