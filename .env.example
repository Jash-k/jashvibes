# Runtime secrets. Copy to .env.local locally, or use your platform secret settings.
# NEVER include the real file in a source ZIP or commit.
PASS=replace-with-a-strong-viewer-password
ADMIN_PASS=replace-with-a-different-strong-owner-password
DB=mongodb+srv://USER:PASSWORD@HOST/DATABASE
SESSION_EPOCH=change-this-random-value-to-revoke-viewer-sessions
SESSION_TTL_DAYS=30

# Public hosting / scheduler. Port is explicit for CLI, standalone and Docker.
PORT=7860
HOSTNAME=0.0.0.0
SITE_URL=
KEEPALIVE=0
LIVE_SYNC_MINUTES=60
CRON_SECRET=

# Metadata and configured addons (manifest URLs or addon base URLs).
TMDB_API_KEY=
STREMIO=
STREMIO_WATCH=
STREMIO_STREAM_TIMEOUT_MS=15000

# Music: supply an available API implementing /api/search/songs,
# /api/songs/{id}, /api/albums?id= and /api/playlists?id=.
# Do not assume a public example mirror is reachable in your region.
SAAVN_API=
SAAVN_MIRRORS=
SAAVN_TIMEOUT_MS=12000
LYRICS_API=https://lrclib.net

# Optional source overrides. Runtime admin registries are authoritative.
MOVIESDA_JSON_URL=https://raw.githubusercontent.com/Jash-k/mv_scrapper/refs/heads/main/data/moviesda.json
MOVIESDA_AUTO_BUDGET_MS=12000
VOD_LIMIT=0
VOD_CONCURRENCY=3

# Owner source/header/guide configuration is stored in MongoDB.
# New live candidates stay unpublished; map them in Admin → TV Service.
