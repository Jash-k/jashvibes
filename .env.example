# ============================================================================
#  JaSH ViBeS — environment reference
# ----------------------------------------------------------------------------
#  Copy to `.env.local` for local dev, or paste into your host's secret settings
#  (Render → Environment). NEVER commit the real file.
#
#  Two things to know before you read on:
#
#  1. REQUIRED vs OPTIONAL. Only the four in §1 have no sane default; everything
#     else is a tuning knob or a provider switch. A missing optional variable is
#     not an error — the code carries a default for every one of them.
#
#  2. Several variables are ALIASES of the same setting. The resolvers try a list
#     of names in order, so `TMDB_KEY` and `TMDB_KEYS` both work. Set the
#     canonical name listed first and ignore the rest; they exist because the app
#     has been deployed by different people under different names.
# ============================================================================

# ── 1. Required ─────────────────────────────────────────────────────────────
# Viewer password for the theatre. Resolution: PASS → SPACE_PASSWORD → APP_PASSWORD
PASS=replace-with-a-strong-viewer-password

# Owner password for /admin. On its own, separate from PASS. No aliases.
ADMIN_PASS=replace-with-a-different-strong-owner-password

# MongoDB connection string. Resolution: DB → DB_URI → MONGODB_URI
DB=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# Rotating this value invalidates every issued session token immediately — it is
# the "log everyone out" switch. Resolution: SESSION_EPOCH → SESSION_SECRET
SESSION_EPOCH=change-this-random-value-to-revoke-viewer-sessions

# ── 2. Hosting / scheduler ──────────────────────────────────────────────────
SITE_URL=                    # public origin, used for absolute links + CSRF origin checks
PORT=7860                    # explicit so CLI, standalone and Docker agree
SESSION_TTL_DAYS=30          # how long a viewer token stays valid
LIVE_SYNC_MINUTES=60         # background live-source resync interval
CRON_SECRET=                 # shared secret for scheduled jobs (alias: SCRAPE_TOKEN, SCRAPE)

# ── 3. TMDB (metadata) ──────────────────────────────────────────────────────
# Two credential types, both accepted. Keys are the classic 32-char v3 key;
# tokens are the long v4 bearer strings. Mixing them in one variable works too —
# values that look like bearer tokens are routed to the token path automatically.
# Keys   : TMDB_KEYS → TMDB_API_KEYS → TMDB_V3_KEYS → TMDB → TMDB_API_KEY →
#          TMDB_KEY → TMDB_V3_API_KEY → THEMOVIEDB_API_KEY → MOVIEDB_API_KEY
# Tokens : TMDB_TOKENS → TMDB_BEARER_TOKENS → TMDB_TOKEN → TMDB_BEARER_TOKEN →
#          TMDB_ACCESS_TOKEN → TMDB_READ_ACCESS_TOKEN → TMDB_V4_TOKEN →
#          TMDB_V4_BEARER_TOKEN
# Multiple values are split on commas/newlines and rotated, so listing several
# raises your rate limit ceiling.
TMDB_API_KEYS=               # preferred: comma-separated v3 keys
TMDB_BEARER_TOKENS=          # optional: comma-separated v4 tokens
TMDB_BASE_URL=https://api.themoviedb.org/

# ── 4. Scrapers ─────────────────────────────────────────────────────────────
# TamilMV (alias: TAMILMV) and its sync window.
TAMILMV_BASE_URL=https://www.1tamilmv.report
TAMILMV_SYNC_INTERVAL_MS=21600000   # 6 h
TAMILMV_CACHE_LIMIT=90
TAMILMV_MAX_POSTER_FETCHES=8        # alias: TAMILMV_POSTERS
TAMILMV_TMDB_OVERRIDES=             # alias: OVERRIDES — manual title→TMDB pins (JSON)

# Moviesda + the movies1/anchored backend that resolves playable links.
MOVIESDA_JSON_URL=https://raw.githubusercontent.com/Jash-k/mv_scrapper/refs/heads/main/data/moviesda.json
MOVIESDA_AUTO_BUDGET_MS=12000
MOVIESDA_TIMEOUT_MS=12000
MOVIESDA_RESOLVE_TTL_MS=2700000     # 45 min
MOVIESDA_INDEX_TTL_MS=1800000       # 30 min
ANCHORHD_BACKEND=https://movies1-backend.onrender.com   # alias: MOVIES1_BACKEND
RESOLVE_SAVE=                       # set to persist resolved links for reuse
SCREENSCAPE_API_KEY=                # alias: SCREENSCAPE — /api/seed source
SEED_TOKEN=                         # alias: SEED — guards /api/debug-scrapers
VOD_SYNC_TOKEN=                     # alias: VOD_SYNC — guards /api/vod/sync
VOD_LIMIT=0                         # 0 = no cap
VOD_CONCURRENCY=3
CLASSICS_LIMIT=0                    # 0 = every title in the ReTro archive

# ── 5. Player sources (embed providers) ─────────────────────────────────────
# Resolution for the priority order: EMBED_PROVIDER_PRIORITY → PROVIDERS
EMBED_PROVIDER_PRIORITY=
VIDSRC_BASE_URL=
VIDSRC_MIRROR_BASE_URL=
VIDSRC_EMBED_BASE_URL=
VIDSRC_FALLBACK_DOMAINS=https://vidsrcme.su
VIDSRC_AUTOPLAY=                    # 1/true to autoplay
VIDSRC_AUTONEXT=
VIDSRC_SUBTITLE_URL=
VIDSRC_DEFAULT_SUBTITLE_LANG=       # e.g. ta, en
VIDLINK_PRIMARY_COLOR=B20710
VIDLINK_SECONDARY_COLOR=170000
VIDLINK_AUTOPLAY=false
VIDLINK_POSTER=true
VIDLINK_TITLE=true
VIDROCK_SERVER=Tamil
VIDROCK_SOURCE=Tamil
VIDROCK_LANG=ta
VIDNEST_SERVER=
VIDZEE_VERSION=
VIDEASY_COLOR=B20710
ONEEMBED_SERVER=                    # alias: ONEEMBED_SR
# External/clean embed list. Resolution: CLEAN_EMBED_SITES → EMBEDS → EMBED_SITES
CLEAN_EMBED_SITES=
CLEAN_EMBED_URL=
CLEAN_EMBED_LABEL=
EXTERNAL_SITE_URL=
EXTERNAL_SITE_LABEL=
SITE_LABEL=
EMBED=
ELABEL=
APP_BASE_URL=http://localhost       # used to build absolute embed URLs

# ── 6. Live TV ──────────────────────────────────────────────────────────────
# Owner source/header/guide configuration lives in MongoDB (Admin → TV Service).
# These only tune the fetchers.
LIVE_TV_SOURCES=                    # alias: TV
JIO_COOKIE=                         # alias: JIO_LIVE_COOKIE
LIVE_EPG_URL=
LIVE_EPG_TZ_MINUTES=                # guide timezone offset
LIVE_EPG_TTL_MS=
LIVE_EPG_TIMEOUT_MS=25000
LIVE_DEEP_TIMEOUT_MS=10000
LIVE_WORKING_TIMEOUT_MS=2500
LIVE_WORKING_CONCURRENCY=64
LIVE_WORKING_CACHE_TTL_MS=300000    # 5 min — how long a "working" probe is trusted
POCKET_HIDE_CHANNELS=               # alias: LIVE_POCKET_HIDE_CHANNELS
POCKET_REMOVE_CHANNELS=             # alias: LIVE_POCKET_REMOVE_CHANNELS

# ── 7. Stremio addons ───────────────────────────────────────────────────────
# Addon URLs. The `_ADDON`/`_MANIFEST` variants are the same slot for addons whose
# manifest is not at the conventional path.
STREMIO=                            # resolution also accepts STREMIO_ADDON_URL, STREMIO_ADDON
STREMIO_WATCH=                      # resolution also accepts STREMIO_WATCH_ADDON
STREMIO_HOME=                       # resolution also accepts STREMIO_CATALOG_ADDON, STREMIO_CATALOG_MANIFEST
STREMIO_PROVIDER=                   # resolution also accepts STREMIO_PROVIDER_ADDON, STREMIO_PROVIDER_MANIFEST
STREMIO_MANIFEST=
STREMIO_CATALOG=
STREMIO_MOVIE_CATALOG=              # defaults to the manifest's first movie catalog
STREMIO_SERIES_CATALOG=             # defaults to the manifest's first series catalog
STREMIO_TMDB_MAX_SEASONS=12
STREMIO_CACHE_TTL_MS=600000         # 10 min
STREMIO_STREAM_TIMEOUT_MS=15000
STREMIO_WATCH_TIMEOUT_MS=25000
STREMIO_WATCH_AUTO_TIMEOUT_MS=15000
STREMIO_ALLOWED_HOSTS=              # allowlist for addon hosts
STREMIO_ALLOW_ANY_HOST=             # only with a trusted addon list

# ── 8. Music ────────────────────────────────────────────────────────────────
# Any service implementing /api/search/songs, /api/songs/{id}, /api/albums?id=
# and /api/playlists?id=. Do not assume a public mirror is reachable in your region.
SAAVN_API=                          # resolution also accepts SAAVN, SAAVN_MIRRORS
SAAVN_MIRRORS=
SAAVN_TIMEOUT_MS=12000
LYRICS_API=https://lrclib.net      # alias: LRCLIB
MUSIC_LANG=Tamil                    # language bias for "new releases"
SYNC=                               # alias: MUSIC_ADMIN_TOKEN — guards playlist writes
SPOTIFY_PROXY=                      # alias: SPOTIFY_METADATA_PROXY
SPOTIFY_PROXY_RETRIES=3
SPOTIFY_PROXY_TIMEOUT_MS=70000
SPOTIFY_IMPORT_CONCURRENCY=2
SPOTIFY_IMPORT_MAX_PLAYLISTS=25
SPOTIFY_IMPORT_MAX_TRACKS=60
SPOTIFY_IMPORT_LANGS=tamil
SPOTIFY_IMPORT_MIN_SCORE=105
SPOTIFY_IMPORT_EARLY_SCORE=175
SPOTIFY_IMPORT_MIN_TITLE_SCORE=0.72
SPOTIFY_IMPORT_QUERY_VARIANTS=4

# Platform-provided — do not set these by hand: NODE_ENV, HOSTNAME, KEEPALIVE.

# ── 9. Alias index ──────────────────────────────────────────────────────────
# Every name the resolvers accept, grouped by the setting it maps to. Listed in
# full so a search for any one of them lands somewhere useful. Set the FIRST name
# in each line; the rest are accepted for compatibility.
#
#   viewer password ....... PASS | SPACE_PASSWORD | APP_PASSWORD
#   database .............. DB | DB_URI | MONGODB_URI
#   session epoch ......... SESSION_EPOCH | SESSION_SECRET
#   TMDB v3 keys .......... TMDB_KEYS | TMDB_API_KEYS | TMDB_V3_KEYS | TMDB |
#                           TMDB_API_KEY | TMDB_KEY | TMDB_V3_API_KEY |
#                           THEMOVIEDB_API_KEY | MOVIEDB_API_KEY
#   TMDB v4 tokens ........ TMDB_TOKENS | TMDB_BEARER_TOKENS | TMDB_TOKEN |
#                           TMDB_BEARER_TOKEN | TMDB_ACCESS_TOKEN |
#                           TMDB_READ_ACCESS_TOKEN | TMDB_V4_TOKEN |
#                           TMDB_V4_BEARER_TOKEN
#   schedule secret ....... SCRAPE_TOKEN | SCRAPE | CRON
#   debug/seed gate ....... SEED_TOKEN | SEED
#   vod sync gate ......... VOD_SYNC_TOKEN | VOD_SYNC
#   music admin gate ...... MUSIC_ADMIN_TOKEN | SYNC
#   saavn base ............ SAAVN_API | SAAVN | SAAVN_MIRRORS
#   lyrics provider ....... LYRICS_API | LRCLIB
#   spotify proxy ......... SPOTIFY_PROXY | SPOTIFY_METADATA_PROXY
#   tamilmv base .......... TAMILMV_BASE_URL | TAMILMV
#   tamilmv poster cap .... TAMILMV_MAX_POSTER_FETCHES | TAMILMV_POSTERS
#   tmdb overrides ........ TAMILMV_TMDB_OVERRIDES | OVERRIDES
#   resolve backend ....... ANCHORHD_BACKEND | MOVIES1_BACKEND
#   embed sites list ...... CLEAN_EMBED_SITES | EMBEDS | EMBED_SITES
#   embed priority ........ EMBED_PROVIDER_PRIORITY | PROVIDERS
#   oneembed server ....... ONEEMBED_SERVER | ONEEMBED_SR
#   seed scraper .......... SCREENSCAPE_API_KEY | SCREENSCAPE
#   live sources .......... LIVE_TV_SOURCES | TV
#   jio cookie ............ JIO_COOKIE | JIO_LIVE_COOKIE
#   pocket hide ........... POCKET_HIDE_CHANNELS | LIVE_POCKET_HIDE_CHANNELS
#   pocket remove ......... POCKET_REMOVE_CHANNELS | LIVE_POCKET_REMOVE_CHANNELS
#   stremio main .......... STREMIO | STREAMIO_ADDON_URL | STREMIO_ADDON |
#                           STREMIO_MANIFEST
#   stremio watch ......... STREMIO_WATCH | STREMIO_WATCH_ADDON
#   stremio catalog ....... STREMIO_HOME | STREMIO_CATALOG_ADDON |
#                           STREMIO_CATALOG_MANIFEST | STREMIO_CATALOG
#   stremio provider ...... STREMIO_PROVIDER | STREMIO_PROVIDER_ADDON |
#                           STREMIO_PROVIDER_MANIFEST
#
# Platform-provided, never set by hand: NODE_ENV, HOSTNAME, KEEPALIVE.
# The misspelled STREAMIO_ADDON_URL is accepted on purpose — it shipped that way
# once, and dropping it would break an existing deployment.
