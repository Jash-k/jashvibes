# JaSH ViBeS — environment variables (Render → Environment, or .env.local for dev)

# ── Required ────────────────────────────────────────────────────────────────
DB=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/jash_theatre?retryWrites=true&w=majority
TMDB=your_tmdb_v3_api_key
PASS=choose_your_private_theatre_password

# ── Sessions ────────────────────────────────────────────────────────────────
# SESSION_EPOCH is the revocation knob: change it (any string) and every issued
# cookie / header / ?token= link stops working immediately, without touching the
# password. SESSION_TTL_DAYS sizes the cookie lifetime (default 180).
# SESSION_EPOCH=
# SESSION_TTL_DAYS=180

# Live TV service panel password (unlock code for /live → Service panel).
# Also works at the main site unlock. NO default: if unset, only PASS unlocks.
# LIVE_TV_PASS=choose_a_panel_password

# ── Keep-alive (Render free tier) ───────────────────────────────────────────
# The server pings /api/health every KEEPALIVE_MINUTES (default 10) so the free
# instance never sleeps. Tiny traffic; keep it on. KEEPALIVE=0 disables it.
# KEEPALIVE=0
# KEEPALIVE_MINUTES=10

# ── Movies & Series ─────────────────────────────────────────────────────────
# PROVIDERS=stremio,mirchi,vidlink,videasy,vidzee,vidrock   # embed priority order
# TAMILMV=https://www.1tamilmv.report/                      # current scraper domain
# CRON_SECRET=token_for_/api/cron/tamilmv                   # external scheduler
# SCRAPE_TOKEN=token_for_forced_tamilmv_refresh
# SEED_TOKEN=token_for_/api/seed

# ── Stremio ─────────────────────────────────────────────────────────────────
# STREMIO=https://your-stremio-addon/manifest.json
# (Optional: the Global Stremio addon is used by default when nothing is set.)

# ── Music (ராக வானம்) ───────────────────────────────────────────────────────
# SAAVN=https://your-saavn-mirror   # music API mirror(s)

# ── ReTro classics (VOD M3U sources) ────────────────────────────────────────
# VOD=ErosNow|https://raw.githubusercontent.com/USER/REPO/main/VOD_ErosNow.m3u,Aha|https://raw.githubusercontent.com/USER/REPO/main/VOD_Aha.m3u
# SYNC_TOKEN=token_for_/api/vod/sync

# ── Embed browser (/embed-browser buttons) ──────────────────────────────────
# EMBEDS=Label|https://embed-site.example/,Example|https://example.com

# ── Live TV ─────────────────────────────────────────────────────────────────
# JIO_LIVE_COOKIE=__hdnea__=st=...~exp=...~acl=/*~hmac=...   # optional Jio fallback token
# LIVE_EPG_URL=https://example.org/epg.xml.gz                # XMLTV guide feed (default: Pocket-EPG)
# LIVE_EPG_TTL_MS=3600000                                    # how long a parsed guide day is reused
# LIVE_EPG_TIMEOUT_MS=25000                                  # feed download timeout
# LIVE_EPG_TZ_MINUTES=330                                    # assumed zone for stamps without an offset
